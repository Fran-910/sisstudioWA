@using sisstudioWA.Servicios.ServicioHttp
@using sisstudioWA.Shared.DTO
@using sisstudioWA.Shared.Enum
@inject IHttpService http

@if (Visible)
{
    @if (eliminarFinalizado)
    {
        #region Carga finalizada

        <div class="sist-overlay" @onclick="CerrarPorOverlay">
            <div class="sist-modal sist-modal--sm" role="dialog" aria-modal="true"
                 aria-labelledby="ep-done-title" tabindex="0"
                 @ref="panelRef" @onkeydown="ManejarTecla" @onclick:stopPropagation="true">

                <header class="sist-modal__header">
                    <div class="sist-modal__header-copy">
                        <h3 class="sist-modal__title" id="ep-done-title">
                            @(TipoFinalizado == TipoProd.Kit ? "Kit eliminado" : "Producto eliminado")
                        </h3>
                        <p class="sist-modal__subtitle">Ya no está en el catálogo.</p>
                    </div>
                    <button type="button" class="sist-icon-btn" @onclick="Cerrar" aria-label="Cerrar">×</button>
                </header>

                <div class="sist-modal__body">
                    <div class="ep-done">
                        <div class="ep-done__preview">
                            @if (!string.IsNullOrEmpty(PortadaFinalizada))
                            {
                                <div class="ep-done__cover">
                                    <img src="@PortadaFinalizada" alt="Portada de @NombreFinalizado" onerror="this.remove()" />
                                </div>
                            }
                            else
                            {
                                <div class="ep-done__cover ep-done__cover--vacia" aria-hidden="true">✦</div>
                            }

                            <p class="ep-done__nombre">@NombreFinalizado</p>

                            <div class="ep-done__meta">
                                @if (TipoFinalizado == TipoProd.Kit)
                                {
                                    <span class="sist-badge sist-badge--kit"><span aria-hidden="true">✦</span> Kit</span>
                                }
                                else
                                {
                                    <span class="sist-badge sist-badge--producto">Producto</span>
                                }
                                <span class="sist-price-tag">@FormatoPrecio(PrecioFinalizado)</span>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(mensajeDeCarga))
                        {
                            <p class="ep-done__mensaje">
                                <span class="ep-done__tick" aria-hidden="true">✓</span>
                                <span>@mensajeDeCarga</span>
                            </p>
                        }
                    </div>
                </div>

                <footer class="sist-modal__footer">
                    <p class="sist-modal__note">La acción ya se completó.</p>
                    <div class="sist-actions">
                        <button type="button" class="sist-btn sist-btn--primary" @onclick="Cerrar">Cerrar</button>
                    </div>
                </footer>
            </div>
        </div>
        #endregion
    }
    else
    {
    <div class="sist-overlay" @onclick="CerrarPorOverlay">
        <div class="sist-modal sist-modal--sm" role="dialog" aria-modal="true" aria-labelledby="eliminar-producto-title" tabindex="0" @ref="panelRef" @onkeydown="ManejarTecla" @onclick:stopPropagation="true">
            <header class="sist-modal__header">
                <div class="sist-modal__header-copy">
                    <h3 class="sist-modal__title" id="eliminar-producto-title">Eliminar producto</h3>
                    <p class="sist-modal__subtitle">Esta acción no se puede deshacer.</p>
                </div>
                <button type="button" class="sist-icon-btn" @onclick="Cerrar" aria-label="Cerrar">×</button>
            </header>

            <div class="sist-modal__body">
                @if (Producto is null)
                {
                    <p class="sist-hint">No hay un producto seleccionado.</p>
                }
                else
                {
                    <div class="ep-confirm">
                        <div class="ep-icon" aria-hidden="true">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M3 6h18"></path>
                                <path d="M8 6V4h8v2"></path>
                                <path d="M19 6l-1 14H6L5 6"></path>
                                <path d="M10 11v6M14 11v6"></path>
                            </svg>
                        </div>
                        <p class="ep-question">¿Querés eliminar <strong>@Producto.Nombre</strong>?</p>
                        <p class="ep-detail">Se borran también sus fotos. El producto #@Producto.id deja de estar en el catálogo.</p>

                        @if (!string.IsNullOrEmpty(errorEliminar))
                        {
                            <div class="sist-alert sist-alert--error" role="alert">@errorEliminar</div>
                        }
                    </div>
                }
            </div>

            <footer class="sist-modal__footer">
                <p class="sist-modal__note">La acción es permanente.</p>
                <div class="sist-actions">
                    <button type="button" class="sist-btn sist-btn--ghost" @onclick="Cerrar">Cancelar</button>
                    @if (Producto is not null)
                    {
                        <button type="button" class="sist-btn sist-btn--danger" @onclick="() => BorrarProducto(Producto)" disabled="@borrando">
                            @(borrando ? "Eliminando..." : "Sí, eliminar")
                        </button>
                    }
                </div>
            </footer>
        </div>
    </div>
    }
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public ProductoPrivadoDTO? Producto { get; set; }
    [Parameter] public EventCallback OnActualizado { get; set; }

    private ElementReference panelRef;
    private bool estabaVisible;
    private bool focoAplicado;
    private bool borrando;
    private bool eliminarFinalizado;
    private string? mensajeDeCarga;
    private string? errorEliminar;
    private ProductoPrivadoDTO? productoEliminado;

    private string NombreFinalizado => productoEliminado?.Nombre ?? string.Empty;

    private TipoProd TipoFinalizado => productoEliminado?.tipoProd ?? TipoProd.Producto;

    private decimal PrecioFinalizado => productoEliminado?.Precio ?? 0;

    private string? PortadaFinalizada => productoEliminado?.Imagenes?.FirstOrDefault();

    private static string FormatoPrecio(decimal precio) =>
        precio.ToString("$ #,##0.##", CultureInfo.GetCultureInfo("es-AR"));

    #region Metodos Estados Componente
    protected override async Task OnParametersSetAsync()
    {
        if (Visible && !estabaVisible)
        {
            focoAplicado = false;
            errorEliminar = null;
            borrando = false;
            eliminarFinalizado = false;
            mensajeDeCarga = null;
            productoEliminado = null;
        }
        estabaVisible = Visible;

        if (!Visible)
        {
            return;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Visible && !focoAplicado)
        {
            try
            {
                await panelRef.FocusAsync();
                focoAplicado = true;
            }
            catch (InvalidOperationException)
            {
            }
        }
    }
    #endregion

    private async Task BorrarProducto(ProductoPrivadoDTO producto)
    {
        errorEliminar = null;
        borrando = true;

        try
        {
            var response = await http.DeleteAsync<bool>($"api/producto/borrar/{producto.id}");
            if (response.IsSuccess)
            {
                productoEliminado = producto;
                mensajeDeCarga = producto.tipoProd == TipoProd.Kit
                    ? "El kit se eliminó correctamente."
                    : "El producto se eliminó correctamente.";
                eliminarFinalizado = true;
                focoAplicado = false;
                await OnActualizado.InvokeAsync();
            }
            else
            {
                errorEliminar = "No pudimos eliminar el producto. Reintentá en unos segundos.";
            }
        }
        catch
        {
            errorEliminar = "No pudimos eliminar el producto. Reintentá en unos segundos.";
        }
        finally
        {
            borrando = false;
            StateHasChanged();
        }
    }

    #region Limpiar Form
    private async Task Cerrar()
    {
        focoAplicado = false;
        borrando = false;
        eliminarFinalizado = false;
        mensajeDeCarga = null;
        errorEliminar = null;
        productoEliminado = null;
        await VisibleChanged.InvokeAsync(false);
    }

    private async Task CerrarPorOverlay()
    {
        await Cerrar();
    }

    private async Task ManejarTecla(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await Cerrar();
        }
    }
    #endregion
}
