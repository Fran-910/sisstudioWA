    private async Task AplicarCambios()
    {
        if (DTO?.DTO is null)
        {
            return;
        }

        errorGuardado = null;

        if (DTO.DTO.tipoProd == TipoProd.Kit && resultadosProcesados.Count == 0)
        {
            errorGuardado = "Agregá al menos un componente antes de guardar el kit.";
            return;
        }

        var url = DTO.DTO.tipoProd == TipoProd.Kit
            ? $"api/producto/kit/{DTO.DTO.id}"
            : $"api/producto/{DTO.DTO.id}";

        const string delurl = "api/producto/delimg";

        guardando = true;

        try
        {
            using var formData = new MultipartFormDataContent();

            foreach (var img in imagenesSeleccionadas)
            {
                var contenido = new ByteArrayContent(img.content);
                contenido.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(img.contentType);
                formData.Add(contenido, "imagenes", img.nombre);
            }

            var imageDTO = new ImageDelDTO
            {
                id = DTO.DTO.id,
                url = imgParaBorrar
            };

            var imgdtoJson = JsonSerializer.Serialize(imageDTO);
            await http.DeleteImg(delurl, imgdtoJson);

            DTO.idProductosKit.Clear();
            foreach (var kitProd in resultadosProcesados)
            {
                for (int i = 0; i < Math.Max(1, kitProd.CantItems); i++)
                {
                    DTO.idProductosKit.Add(kitProd.Id);
                }
            }

            DTO.DTO.Nombre ??= string.Empty;
            DTO.DTO.Subtitulo ??= string.Empty;
            DTO.DTO.Descripcion ??= string.Empty;

            formData.Add(new StringContent(JsonSerializer.Serialize(DTO)), "producto");

            var response = await http.UpdateFormDataAsync(url, formData);
            if (response.IsSuccess)
            {
                mensajeDeCarga = response.Data;
                cargaFinalizada = true;
                focoAplicado = false;
                await OnActualizado.InvokeAsync();
                StateHasChanged();
            }
            else
            {
                errorGuardado = response.Data;
            }
        }
        catch
        {
            errorGuardado = "No hubo respuesta por parte del servidor.";
        }
        finally
        {
            guardando = false;
            StateHasChanged();
        }
    }

    private void Editar()
    {
        if (Producto is null)
        {
            return;
        }

        DTO = new CUProductoRequestDTO
        {
            DTO = new ProductoPrivadoDTO
            {
                id = Producto.id,
                Nombre = Producto.Nombre,
                Subtitulo = Producto.Subtitulo,
                Descripcion = Producto.Descripcion,
                Precio = Producto.Precio,
                Stock = Producto.Stock,
                tipoProd = Producto.tipoProd,
                Imagenes = new List<string>(Producto.Imagenes ?? new List<string>())
            }
        };

        editContext = new EditContext(DTO.DTO);

        editarMode = true;
        imgParaBorrar.Clear();
        imagenesSeleccionadas.Clear();
        productosBusqueda = new List<ProductoPrivadoDTO>();
        terminoBusqueda = string.Empty;
        busquedaState = string.Empty;
        currentCantProd = 1;
        cargaFinalizada = false;
        mensajeDeCarga = null;
        errorGuardado = null;
        mensajeFotos = null;
        StateHasChanged();
    }

    private void MoverImagen(int delta)
    {
        var total = ImagenesProducto.Count;
        if (total == 0)
        {
            return;
        }

        indiceImagen = (indiceImagen + delta + total) % total;
    }
